# Optional. Without this, Aperture runs in offline mode with a deterministic
# mock LLM adapter -- useful for demos, CI, and development without burning
# API credits.
ANTHROPIC_API_KEY=

# Optional. Defaults to claude-sonnet-4-5.
ANTHROPIC_MODEL=

# Optional. If set, the publish step POSTs the finished draft to this URL
# instead of using the mock publisher. Handy for testing against
# https://webhook.site or a real CMS ingestion endpoint.
PUBLISH_WEBHOOK_URL=

# Optional. Port for `npm run server`. Defaults to 3000.
PORT=
